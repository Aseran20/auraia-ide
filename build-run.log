+++ . ../utils.sh
++++ APP_NAME=Arclen
+++++ echo Arclen
+++++ awk '{print tolower($0)}'
++++ APP_NAME_LC=arclen
++++ ASSETS_REPOSITORY=Aseran20/auraia-ide
++++ BINARY_NAME=arclen
++++ GH_REPO_PATH=Aseran20/auraia-ide
++++ ORG_NAME=Arclen
++++ TUNNEL_APP_NAME=arclen-tunnel
++++ [[ stable == \i\n\s\i\d\e\r ]]
++++ GLOBAL_DIRNAME=arclen
++++ exists gsed
++++ type -t gsed
++++ is_gnu_sed
++++ sed --version
+++ echo 'APP_NAME="Arclen"'
APP_NAME="Arclen"
+++ echo 'APP_NAME_LC="arclen"'
