+++ [[ '' == \y\e\s ]]
+++ for file in ../patches/*.json
+++ [[ -f ../patches/51-ext-copilot-remove-it.json ]]
+++ apply_actions ../patches/51-ext-copilot-remove-it.json
+++ jq -c '.[]' ../patches/51-ext-copilot-remove-it.json
+++ IFS=
+++ read -r ENTRY
++++ jq -r '.action // empty'
+++ ENTRY_ACTION=remove
+++ case "${ENTRY_ACTION}" in
+++ jq -r '.paths[]'
+++ IFS=
+++ read -r ENTRY_PATH
+++ ENTRY_PATH=extensions/copilot
+++ [[ -e extensions/copilot ]]
+++ rm -rf -- extensions/copilot
+++ echo 'Removed: extensions/copilot'
